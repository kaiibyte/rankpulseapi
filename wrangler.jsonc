
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rankpulseapi",
  "account_id": "164f26b4a618b7d341864e5a7a4c484b",
  "main": "src/worker.py",
  "compatibility_date": "2026-09-25",
  "compatibility_flags": [
    "python_workers"
  ],
  "build": {
    "command": "uv run pywrangler sync",
    "watch_dir": "src"
  },
  "assets": {
    "directory": "./public"
  },
  "vars": {
    "DEBUG": "false",
    "IS_MAINTENANCE": "false",
    "IS_HIGH_TRAFFIC": "false",
    "USE_WSRV": "true",
    "BASE_URL": "https://arena.rone.dev/"
  },
  "secrets": {
    "required": [
      "SECRET_KEY"
    ]
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "previews": {
    "vars": {
      "DEBUG": "false",
      "IS_MAINTENANCE": "false",
      "IS_HIGH_TRAFFIC": "false",
      "USE_WSRV": "true",
      "BASE_URL": "https://arena.rone.dev/"
    },
    "version_metadata": {
      "binding": "CF_VERSION_METADATA"
    }
  },
  "routes": [],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true
  },
  "python_modules": {
    "exclude": [
      "**/*.pyc",
      "**/__pycache__"
    ]
  }
}
